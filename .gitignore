# Ignore all
*

# Unignore all with extensions
!*.*

# Unignore all dirs
!*/

### Above combination will ignore all files without extension (From https://stackoverflow.com/a/25592735)  ###

# Ignore files with only an extension
.*

# Ignore Archives
*.tar
*.tar.gz

# Ignore backup files
*.bak

# Ignore log files
*.log
*.data
*vgcore*
heaptrack*

# Ignore Build Directory. Meson should do this
# automatically, but still, just in case.
build*

# Keep Specific Files
!.clang-format
!.clang-tidy
!.gitattributes
!.gitignore
!LICENSE

# Keep specific directories and their contents
!.github
!.github/*

!.run/
!.run/*
